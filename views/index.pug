extends layout

block content
  h1= title
  p
    a.button(href='/books/new') Create New Book
  table
    thead
      tr
        th Title
        th Author
        th Genre
        th Year
    tbody
      each Book in Books
        tr
          td
            a(href='/books/' + Book.id)= Book.title 
          td= Book.author
          td= Book.genre
          td= Book.year
